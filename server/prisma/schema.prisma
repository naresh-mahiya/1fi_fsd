generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  brand       String
  name        String
  description String
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  color     String
  colorHex  String
  storage   String
  ram       String?
  mrp       Int
  price     Int
  imageUrl  String
  position  Int       @default(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  emiPlans  EmiPlan[]

  @@unique([productId, color, storage])
  @@index([productId, position])
}

model FundPartner {
  id       String    @id @default(cuid())
  name     String    @unique
  emiPlans EmiPlan[]
}

model EmiPlan {
  id               String         @id @default(cuid())
  variantId        String
  fundPartnerId    String
  tenureMonths     Int
  monthlyPayment   Int
  interestRate     Decimal        @db.Decimal(5, 2)
  cashbackAmount   Int?
  position         Int            @default(0)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fundPartner      FundPartner    @relation(fields: [fundPartnerId], references: [id])

  @@unique([variantId, tenureMonths, fundPartnerId])
  @@index([variantId, position])
}
