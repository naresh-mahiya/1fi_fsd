# Local PostgreSQL database used by Prisma and the API
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emi_store?schema=public"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emi_store?schema=public"

# Optional outside production. The API defaults to port 3000.
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
